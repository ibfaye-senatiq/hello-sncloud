{
  "name": "hello-sncloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0 <24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node -e \"const k=['SNCLOUD_CANARY_RUNTIME_ONLY','SNCLOUD_CANARY_BUILD_ONLY','DATABASE_URL','DIRECT_URL'];console.log('[env-scope-canary] phase=build '+k.map(x=>x+'='+(process.env[x]?'PRESENT':'ABSENT')).join(' '))\"",
    "start": "node -e \"const k=['SNCLOUD_CANARY_RUNTIME_ONLY','SNCLOUD_CANARY_BUILD_ONLY','DATABASE_URL','DIRECT_URL'];console.log('[env-scope-canary] phase=runtime '+k.map(x=>x+'='+(process.env[x]?'PRESENT':'ABSENT')).join(' '))\" && next start"
  },
  "dependencies": {
    "next": "^15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
